{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "2.0.0.0",
    "parameters": {
        "staticSiteLocation": {
            "type": "string",
            "defaultValue": "westeurope",
            "allowedValues": [
                "westeurope",
                "centralus",
                "eastus2",
                "westus2",
                "eastasia"
            ],
            "metadata": {
                "description": "Static Web Apps is only available in a subset of regions, which is why this is separate from the resource group location."
            }
        },
        "deployCustomDomain": {
            "type": "bool",
            "defaultValue": true,
            "metadata": {
                "description": "Requires the hostname CNAME to point at the Static Web App, which Azure validates at deploy time. Set to false when bootstrapping into a new environment where DNS does not point here yet."
            }
        }
    },
    "variables": {
        "prefix": "CaseSchollaartNet",
        "staticSiteName": "[variables('prefix')]",
        "hostname": "case.schollaart.net"
    },
    "resources": [
        {
            "type": "Microsoft.Web/staticSites",
            "apiVersion": "2023-01-01",
            "name": "[variables('staticSiteName')]",
            "location": "[parameters('staticSiteLocation')]",
            "sku": {
                "name": "Free",
                "tier": "Free"
            },
            "properties": {
                "allowConfigFileUpdates": true,
                "stagingEnvironmentPolicy": "Enabled"
            },
            "metadata": {
                "comments": "No repositoryUrl/branch on purpose: that would make Azure generate and commit its own workflow file. Content is pushed by .github/workflows/pipeline.yml using the deployment token."
            },
            "resources": [
                {
                    "type": "customDomains",
                    "apiVersion": "2023-01-01",
                    "name": "[variables('hostname')]",
                    "condition": "[parameters('deployCustomDomain')]",
                    "dependsOn": [
                        "[resourceId('Microsoft.Web/staticSites', variables('staticSiteName'))]"
                    ],
                    "properties": {
                        "validationMethod": "cname-delegation"
                    }
                }
            ]
        }
    ],
    "outputs": {
        "staticSiteName": {
            "type": "string",
            "value": "[variables('staticSiteName')]"
        },
        "staticSiteDefaultHostname": {
            "type": "string",
            "value": "[reference(resourceId('Microsoft.Web/staticSites', variables('staticSiteName'))).defaultHostname]"
        }
    }
}
